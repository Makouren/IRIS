# IRIS AI File Scanner — Environment Configuration
# ==================================================
# Copy this file to .env and fill in any values you need.

# Google Gemini API key (optional — free tier)
# Get one at: https://aistudio.google.com/apikey
# If not set, chart suggestions use heuristic rules instead of AI.
GEMINI_API_KEY=

# Path to the Tesseract OCR executable.
# - Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# - Linux/Docker: /usr/bin/tesseract (usually auto-detected)
# Leave empty to use the system PATH default.
TESSERACT_CMD=

# Maximum upload file size in megabytes.
MAX_FILE_SIZE_MB=25

# Comma-separated list of allowed file extensions.
ALLOWED_EXTENSIONS=.xlsx,.xls,.csv,.pdf,.docx,.png,.jpg,.jpeg,.webp
